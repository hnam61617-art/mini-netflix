digraph G {
graph [rankdir=TB, bgcolor="white", nodesep=0.30, ranksep=0.7, pad=0.2, fontname="DejaVu Sans", label="Mini-Netflix — Lược đồ quan hệ (MySQL)", labelloc=t, fontsize=20];
node [shape=plain,fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans",fontsize=9,color="#536479",arrowsize=0.7];
content_genres [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e8f3e9"><B>content_genres</B></TD></TR><TR><TD ALIGN="LEFT">content_id</TD><TD ALIGN="LEFT">int</TD><TD>PK/FK</TD></TR><TR><TD ALIGN="LEFT">genre_id</TD><TD ALIGN="LEFT">int</TD><TD>PK/FK</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK(content_id, genre_id)</TD></TR></TABLE>>];
contents [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e8f3e9"><B>contents</B></TD></TR><TR><TD ALIGN="LEFT">content_id</TD><TD ALIGN="LEFT">int</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">varchar(255)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text</TD><TD> ?</TD></TR><TR><TD ALIGN="LEFT">date_released</TD><TD ALIGN="LEFT">date</TD><TD> ?</TD></TR><TR><TD ALIGN="LEFT">content_type</TD><TD ALIGN="LEFT">varchar(10)</TD><TD></TD></TR></TABLE>>];
episodes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e8f3e9"><B>episodes</B></TD></TR><TR><TD ALIGN="LEFT">episode_id</TD><TD ALIGN="LEFT">int</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">content_id</TD><TD ALIGN="LEFT">int</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">episode_number</TD><TD ALIGN="LEFT">int</TD><TD></TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">varchar(255)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">duration</TD><TD ALIGN="LEFT">int</TD><TD></TD></TR><TR><TD ALIGN="LEFT">video_url</TD><TD ALIGN="LEFT">varchar(500)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">date_released</TD><TD ALIGN="LEFT">date</TD><TD> ?</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UQ(content_id, episode_number)</TD></TR></TABLE>>];
genres [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e8f3e9"><B>genres</B></TD></TR><TR><TD ALIGN="LEFT">genre_id</TD><TD ALIGN="LEFT">int</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">genre_name</TD><TD ALIGN="LEFT">varchar(50)</TD><TD>UQ</TD></TR></TABLE>>];
movies [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e8f3e9"><B>movies</B></TD></TR><TR><TD ALIGN="LEFT">content_id</TD><TD ALIGN="LEFT">int</TD><TD>PK/FK</TD></TR><TR><TD ALIGN="LEFT">video_url</TD><TD ALIGN="LEFT">varchar(500)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">duration</TD><TD ALIGN="LEFT">int</TD><TD></TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e6eef7"><B>payments</B></TD></TR><TR><TD ALIGN="LEFT">payment_id</TD><TD ALIGN="LEFT">int</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">subscription_id</TD><TD ALIGN="LEFT">int</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">prices</TD><TD ALIGN="LEFT">decimal(10,2)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">transaction_method</TD><TD ALIGN="LEFT">varchar(30)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">history_payment</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR></TABLE>>];
profiles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e6eef7"><B>profiles</B></TD></TR><TR><TD ALIGN="LEFT">profile_id</TD><TD ALIGN="LEFT">int</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">int</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">profile_name</TD><TD ALIGN="LEFT">varchar(50)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">avatar_url</TD><TD ALIGN="LEFT">varchar(500)</TD><TD> ?</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR></TABLE>>];
subscription_tiers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e6eef7"><B>subscription_tiers</B></TD></TR><TR><TD ALIGN="LEFT">tier_id</TD><TD ALIGN="LEFT">int</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">tier_name</TD><TD ALIGN="LEFT">varchar(50)</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT">prices</TD><TD ALIGN="LEFT">decimal(10,2)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">max_profile</TD><TD ALIGN="LEFT">int</TD><TD></TD></TR><TR><TD ALIGN="LEFT">max_device</TD><TD ALIGN="LEFT">int</TD><TD></TD></TR><TR><TD ALIGN="LEFT">video_quality</TD><TD ALIGN="LEFT">varchar(10)</TD><TD></TD></TR></TABLE>>];
subscriptions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e6eef7"><B>subscriptions</B></TD></TR><TR><TD ALIGN="LEFT">subscription_id</TD><TD ALIGN="LEFT">int</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">int</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">tier_id</TD><TD ALIGN="LEFT">int</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">start_date</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR><TR><TD ALIGN="LEFT">end_date</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR><TR><TD ALIGN="LEFT">auto_renew</TD><TD ALIGN="LEFT">tinyint(1)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(10)</TD><TD></TD></TR></TABLE>>];
tv_series [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e8f3e9"><B>tv_series</B></TD></TR><TR><TD ALIGN="LEFT">content_id</TD><TD ALIGN="LEFT">int</TD><TD>PK/FK</TD></TR><TR><TD ALIGN="LEFT">total_episodes</TD><TD ALIGN="LEFT">int</TD><TD></TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e6eef7"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">int</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">varchar(10)</TD><TD>UQ</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">varchar(255)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR></TABLE>>];
watch_histories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#fff0df"><B>watch_histories</B></TD></TR><TR><TD ALIGN="LEFT">history_id</TD><TD ALIGN="LEFT">int</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">profile_id</TD><TD ALIGN="LEFT">int</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">content_id</TD><TD ALIGN="LEFT">int</TD><TD>FK ?</TD></TR><TR><TD ALIGN="LEFT">episode_id</TD><TD ALIGN="LEFT">int</TD><TD>FK ?</TD></TR><TR><TD ALIGN="LEFT">last_watch_at</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR><TR><TD ALIGN="LEFT">watch_progress</TD><TD ALIGN="LEFT">decimal(5,2)</TD><TD></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UQ(profile_id, content_id)<BR/>UQ(profile_id, episode_id)<BR/>CHECK: đúng một đích xem; 0 ≤ watch_progress ≤ 100</TD></TR></TABLE>>];
watch_lists [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#fff0df"><B>watch_lists</B></TD></TR><TR><TD ALIGN="LEFT">profile_id</TD><TD ALIGN="LEFT">int</TD><TD>PK/FK</TD></TR><TR><TD ALIGN="LEFT">content_id</TD><TD ALIGN="LEFT">int</TD><TD>PK/FK</TD></TR><TR><TD ALIGN="LEFT">added_at</TD><TD ALIGN="LEFT">datetime</TD><TD></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK(profile_id, content_id)</TD></TR></TABLE>>];
contents -> content_genres [label="content_id", arrowhead=crowodot, arrowtail=teetee, dir=both];
genres -> content_genres [label="genre_id", arrowhead=crowodot, arrowtail=teetee, dir=both];
tv_series -> episodes [label="content_id", arrowhead=crowodot, arrowtail=teetee, dir=both];
contents -> movies [label="content_id", arrowhead=teeodot, arrowtail=teetee, dir=both];
subscriptions -> payments [label="subscription_id", arrowhead=crowodot, arrowtail=teetee, dir=both];
users -> profiles [label="user_id", arrowhead=crowodot, arrowtail=teetee, dir=both];
subscription_tiers -> subscriptions [label="tier_id", arrowhead=crowodot, arrowtail=teetee, dir=both];
users -> subscriptions [label="user_id", arrowhead=crowodot, arrowtail=teetee, dir=both];
contents -> tv_series [label="content_id", arrowhead=teeodot, arrowtail=teetee, dir=both];
movies -> watch_histories [label="content_id", arrowhead=crowodot, arrowtail=teeodot, dir=both];
episodes -> watch_histories [label="episode_id", arrowhead=crowodot, arrowtail=teeodot, dir=both];
profiles -> watch_histories [label="profile_id", arrowhead=crowodot, arrowtail=teetee, dir=both];
contents -> watch_lists [label="content_id", arrowhead=crowodot, arrowtail=teetee, dir=both];
profiles -> watch_lists [label="profile_id", arrowhead=crowodot, arrowtail=teetee, dir=both];
{rank=same;users;subscription_tiers;contents;genres;}
{rank=same;profiles;subscriptions;movies;tv_series;content_genres;}
{rank=same;payments;episodes;watch_lists;}
}